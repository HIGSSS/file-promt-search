<?xml version="1.0" encoding="utf-8"?>
<!--
    Конфигурация FileProvider для open_filex.
    Декларирует, какие пути доступны для sharing через content://.
    Открытый доступ ко всему внешнему хранилищу нужен, т.к. пользователь
    может искать файлы где угодно на устройстве.
-->
<paths>
    <external-path name="external_files" path="." />
    <external-files-path name="external_files_app" path="." />
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
</paths>
